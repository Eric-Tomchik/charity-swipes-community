  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "sync": "bunx convex dev --once",
    "sync:build": "bunx convex dev --once && bun run build",
    "logs": "bunx convex logs",
    "logs:fetch": "bun run --bun scripts/logs.ts",
    "test": "bun run --bun scripts/test.ts",
    "test:auth": "bun run --bun scripts/auth.ts",
    "test:demo": "bun run --bun scripts/demo-test.ts",
    "screenshot": "bun run --bun /work/.viktor-spaces-internal/cs-community-74db6266eed5-c5fff2563f5e2cb4/screenshot.ts",
    "env:get": "bunx convex env get",
    "env:list": "bunx convex env list",
    "cap:init": "npx cap init \"Charity Swipes\" com.charityswipes.community --web-dir dist",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:android": "npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "mobile:build": "npm run build && npx cap sync",
    "mobile:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "mobile:android": "npm run build && npx cap sync android && npx cap open android",
    "test:viktor-spaces-access": "bun test scripts/viktor-spaces-access.test.tsx"
